{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C",
            "type": "shell",
            "command": "gcc",
               "args": [
                   "-g",
                   "-lm",
                   "${workspaceFolder}/${fileBasename}",
                   "-o",
                   "${workspaceFolder}/${fileBasenameNoExtension}.out"
               ],
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
    ]
}